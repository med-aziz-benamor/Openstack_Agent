# OpenStack Admin Assistant Portal - Environment Configuration

# Maximum upload size in megabytes
MAX_UPLOAD_SIZE_MB=100

# Temporary directory for bundle extraction
TEMP_DIR=/tmp

# Logging level (debug, info, warning, error)
LOG_LEVEL=info

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Nginx Configuration
NGINX_PORT=8088
